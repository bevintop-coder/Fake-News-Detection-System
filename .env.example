# Application
APP_NAME=Fake-News-Detection-System
APP_ENV=development
LOG_LEVEL=INFO

# Machine Learning
MODEL_PATH=python-ml/news_model.pkl
VECTORIZER_PATH=python-ml/vectorizer.pkl
DATASET_PATH=python-ml/news_dataset.csv

# NLP
ENABLE_TEXT_PREPROCESSING=true
MAX_TEXT_LENGTH=10000

# Model Configuration
PREDICTION_THRESHOLD=0.5
REAL_LABEL=REAL
FAKE_LABEL=FAKE
RANDOM_STATE=42

# OpenAI - optional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
USE_OPENAI=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# Authentication
API_KEY=

# Database - optional
DATABASE_URL=sqlite:///fake_news.db

# Logging
ENABLE_LOGGING=true
LOG_LEVEL=INFO
